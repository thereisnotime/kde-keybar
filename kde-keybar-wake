#!/usr/bin/env python3
"""
kde-keybar-wake: listen on the microphone and print "wake" each time a wake phrase is heard.

kde-keybar starts this helper when dictation.wake_word.enabled is true and begins a
dictation on every "wake" line. It runs with the interpreter of a venv that has Vosk
(`just setup-wakeword`), so the bar itself never imports Vosk.

The recognizer gets a small grammar: the phrase, each of its words on its own, a few
hundred common English words (DECOYS), and "[unk]". With only [phrase, "[unk]"] every
utterance gets forced towards the phrase, so "start" alone or "start the car" decode as
"start dictation" and fire. The decoys give that speech somewhere else to go, at roughly
twice the CPU of the bare grammar (--no-decoys turns them off). Hits are taken from
partial results for low latency, but only once the phrase has stayed in the partial for
STABLE_CHUNKS in a row (a final result counts at once): early partials flicker, and that
alone removes a good share of false hits. After a hit the recognizer is reset and further
hits are ignored for a short debounce window.

Exit status 3 means a setup problem (no Vosk, no model, no recorder); retrying won't help.
"""

import argparse
import json
import os
import signal
import subprocess
import sys

RATE = 16000
CHUNK = RATE // 10 * 2  # 100 ms of s16le mono
# Common words the decoder can pick instead of the phrase (see the module docstring).
DECOYS = """
    a i an as at be by do go he if in is it me my no of oh on or so to up us we act add
    ago air all and any are ask big box boy but can car cry cut day did dog dry eat end
    eye far few fly for get got had has her him his hot how lay let low man map may men
    new now off old one our out own put ran red run saw say sea see set she six sun ten
    the too top try two use war was way who why yes you able also area back base been
    best bird blue boat body book both busy call came care city cold come dark deep does
    done door down draw each ease east even ever face fact fall farm fast feel feet fill
    find fine fire fish five food foot form four free from full game gave girl give gold
    good grow half hand hard have head hear heat help here high hold home hour idea inch
    just keep kind king knew know land last late lead left less life like line list live
    long look love made main make many mark mean mile mind miss moon more most move much
    must name near need next note noun once only open over page part pass plan play port
    pose pull rain read real rest road rock room rule said same seem self ship show side
    sing slow snow some song soon star stay step stop such sure tail take talk tell test
    than that them then they this time tire told took town tree true turn unit verb very
    wait walk want warm week well went were west what when will wind with wood word work
    year your about above after again among began begin black bring build carry cause
    check class clear close color could cover cross drive early earth every field final
    first force found front great green group heard horse house large laugh learn leave
    light might money music never night north ocean often order other paint paper piece
    place plain plane plant point pound power press quick reach ready right river round
    serve shape short since small sound south space spell stand start state stead still
    stood story study table teach their there these thing think those three under until
    usual voice vowel watch water wheel where which while white whole world would write
    young always animal answer appear beauty before behind better center change common
    course decide differ direct during enough equate family father figure follow friend
    govern ground happen island letter listen little minute mother notice number object
    people person record school second should simple street strong system though toward
    travel wonder against between brought certain contain correct country develop
    distant example hundred machine measure morning nothing numeral pattern picture
    problem produce product science several special surface thought through children
    complete interest language mountain multiply possible question remember sentence
    thousand together
""".split()

DEBOUNCE_S = 1.5  # one utterance of the phrase never fires twice
STABLE_CHUNKS = 4  # partial results in a row (100 ms each) that must contain the phrase
DEFAULT_PHRASE = "hey scribe"
SETUP_ERROR = 3
DEFAULT_MODEL = "~/.local/share/kde-keybar/models/vosk-model-small-en-us-0.15"
RECORDERS = (
    [
        "parecord",
        "--raw",
        "--channels=1",
        f"--rate={RATE}",
        "--format=s16le",
        "--latency-msec=50",
    ],
    ["pw-record", f"--rate={RATE}", "--channels=1", "--format=s16", "--latency=50ms", "-"],
)


def fail(msg, code=SETUP_ERROR):
    print(f"kde-keybar-wake: {msg}", file=sys.stderr)
    sys.exit(code)


def words(text):
    return text.lower().replace("[unk]", " ").split()


def contains(haystack, needle):
    n = len(needle)
    return n > 0 and any(haystack[i : i + n] == needle for i in range(len(haystack) - n + 1))


def open_recorder():
    for argv in RECORDERS:
        try:
            return subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        except FileNotFoundError:
            continue
    fail("no recorder found (install pulseaudio-utils for parecord, or pw-record)")


def main(argv=None):
    ap = argparse.ArgumentParser(
        prog="kde-keybar-wake", description=__doc__.strip().splitlines()[0]
    )
    ap.add_argument(
        "--phrase", default=DEFAULT_PHRASE, help=f"wake word or phrase (default: {DEFAULT_PHRASE})"
    )
    ap.add_argument("--model", default=DEFAULT_MODEL, help="Vosk model directory")
    ap.add_argument(
        "--stdin", action="store_true", help="read raw s16le 16 kHz mono from stdin (for tests)"
    )
    ap.add_argument(
        "--no-decoys",
        action="store_true",
        help="grammar of only the phrase + [unk]: cheaper, but far more false wakes",
    )
    args = ap.parse_args(argv)

    phrase = " ".join(args.phrase.lower().split())
    if not phrase:
        fail("--phrase is empty")
    model_dir = os.path.expanduser(args.model)
    if not os.path.isdir(model_dir):
        fail(f"no Vosk model at {model_dir} (run: just setup-wakeword)")
    try:
        import vosk
    except ImportError:
        fail(f"vosk is not importable by {sys.executable} (run: just setup-wakeword)")

    vosk.SetLogLevel(-1)
    try:
        model = vosk.Model(model_dir)
    except Exception as e:  # vosk raises a bare Exception on a bad model dir
        fail(f"could not load the Vosk model at {model_dir}: {e}")
    # Vosk silently drops grammar words it doesn't know, which would leave a phrase that
    # can never match. Say so instead of listening forever for nothing.
    unknown = [w for w in phrase.split() if model.vosk_model_find_word(w) < 0]
    if unknown:
        fail(f"not in the model's vocabulary: {', '.join(unknown)}; pick other words")
    grammar = [phrase, "[unk]"]
    if not args.no_decoys:
        # Vosk drops (and complains about) words it doesn't know, so filter first.
        extra = dict.fromkeys(phrase.split() + DECOYS)
        grammar += [w for w in extra if model.vosk_model_find_word(w) >= 0]
    rec = vosk.KaldiRecognizer(model, RATE, json.dumps(grammar))
    target = phrase.split()

    proc = None
    if args.stdin:
        src = sys.stdin.buffer
    else:
        proc = open_recorder()
        src = proc.stdout
    parent = os.getppid()

    def bye(*_):
        # Exit right away: there is nothing to flush, and a normal interpreter shutdown
        # runs Vosk's deallocators, where a second SIGTERM (the bar and systemd both send
        # one on stop) lands and prints "Exception ignored" tracebacks.
        if proc:
            proc.terminate()
        os._exit(0)

    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGINT, bye)

    pos = 0  # bytes of audio consumed; the debounce runs on audio time so tests are exact
    last_hit = None
    streak = 0
    while True:
        data = src.read(CHUNK)
        if not data:
            break
        pos += len(data)
        # The bar went away without stopping us (crash, SIGKILL): don't keep the mic open.
        if proc and os.getppid() != parent:
            break
        final = rec.AcceptWaveform(data)
        if final:
            text = json.loads(rec.Result()).get("text", "")
        else:
            text = json.loads(rec.PartialResult()).get("partial", "")
        if not contains(words(text), target):
            streak = 0
            continue
        streak += 1
        if not final and streak < STABLE_CHUNKS:
            continue
        streak = 0
        now = pos / (RATE * 2)
        rec.Reset()
        if last_hit is not None and now - last_hit < DEBOUNCE_S:
            continue
        last_hit = now
        try:
            print("wake", flush=True)
        except BrokenPipeError:
            break
    if proc:
        proc.terminate()
        code = proc.wait()
        if code not in (0, -signal.SIGTERM):
            fail(f"recorder exited with status {code}", 1)
    return 0


if __name__ == "__main__":
    sys.exit(main())
