_MISSING = object()


def cfg_get(cfg, path, default=_MISSING):
    """Value at a dot path ("dictation.model"), or default if any part is missing."""
    cur = cfg
    for part in path.split("."):
        if not isinstance(cur, dict) or part not in cur:
            return default
        cur = cur[part]
    return cur


def cfg_set(cfg, path, value):
    """Set a dot path, creating intermediate objects. Existing keys keep their position."""
    *parents, last = path.split(".")
    cur = cfg
    for part in parents:
        if not isinstance(cur.get(part), dict):
            cur[part] = {}
        cur = cur[part]
    cur[last] = value


def cfg_del(cfg, path):
    *parents, last = path.split(".")
    cur = cfg_get(cfg, ".".join(parents)) if parents else cfg
    if isinstance(cur, dict):
        cur.pop(last, None)


def save_config(path, data):
    """Write the config atomically and return the file actually written.

    A symlinked config (e.g. into a dotfiles repo) stays a symlink: the target is resolved
    and replaced via a temp file in its own directory, the link itself is never touched."""
    real = os.path.realpath(path)
    folder = os.path.dirname(real)
    os.makedirs(folder, exist_ok=True)
    text = json.dumps(data, indent=2, ensure_ascii=False) + "\n"
    try:
        mode = stat.S_IMODE(os.stat(real).st_mode)
    except FileNotFoundError:
        umask = os.umask(0)
        os.umask(umask)
        mode = 0o666 & ~umask
    fd, tmp = tempfile.mkstemp(prefix=f".{os.path.basename(real)}.", suffix=".tmp", dir=folder)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, real)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise
    return real


