def _index_of(choices, value):
    """Index of value in choices, comparing type too (so False never matches 0)."""
    for i, c in enumerate(choices):
        if type(c) is type(value) and c == value:
            return i
    return -1


def _dropdown(labels, selected=0):
    dd = Gtk.DropDown.new_from_strings([str(x) for x in labels])
    dd.set_selected(max(0, selected))
    return dd


def _clear(box):
    while (child := box.get_first_child()) is not None:
        box.remove(child)


def chord_editor(keys, on_change, empty_text="(none)"):
    """Removable key-name chips plus a picker of KEYCODES names, so unknown names can
    not be added. Names already in the config that are unknown are shown in red."""
    keys = [str(k) for k in keys]
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
    chips = Gtk.FlowBox()
    chips.set_selection_mode(Gtk.SelectionMode.NONE)
    chips.set_max_children_per_line(12)
    chips.set_column_spacing(6)
    chips.set_row_spacing(6)
    names = list(KEYCODES)
    picker = _dropdown(names)
    picker.set_enable_search(True)
    picker.set_expression(Gtk.PropertyExpression.new(Gtk.StringObject, None, "string"))
    add = Gtk.Button(label="Add key")
    row = Gtk.Box(spacing=6)
    row.append(picker)
    row.append(add)

    def refresh():
        chips.remove_all()
        if not keys:
            chips.append(Gtk.Label(label=empty_text, xalign=0))
        for i, k in enumerate(keys):
            chip = Gtk.Button(label=f"{k}  ✕")
            chip.add_css_class("chip")
            chip.set_tooltip_text("Remove")
            if KEYCODES.get(k.upper()) is None:
                chip.add_css_class("bad")
            chip.connect("clicked", lambda _b, i=i: GLib.idle_add(remove, i))
            chips.append(chip)

    def remove(i):  # idle: refresh() destroys the chip that was tapped
        keys.pop(i)
        refresh()
        on_change(list(keys))
        return False

    def on_add(_b):
        keys.append(names[picker.get_selected()])
        refresh()
        on_change(list(keys))

    add.connect("clicked", on_add)
    refresh()
    box.append(chips)
    box.append(row)
    return box


class SettingsWindow:
    """GTK4 editor for the config file. Edits a copy of the file as parsed (not merged
    with defaults), so only keys you touch are written and unknown keys pass through."""

    def __init__(self, path, on_saved=None, on_closed=None, tab="general"):
        self.path = path
        self.on_saved = on_saved
        self.on_closed = on_closed
        self.load_error = None
        try:
            with open(path, encoding="utf-8") as f:
                self.data = json.load(f)
            if not isinstance(self.data, dict):
                raise ValueError("the top level is not a JSON object")
        except FileNotFoundError:
            self.data = copy.deepcopy(DEFAULT_CONFIG)
        except (OSError, ValueError) as e:  # JSONDecodeError is a ValueError
            self.data = {}
            self.load_error = f"Can't read {path}: {e}. Fix or remove the file; saving is off."
        btns = self.data.get("buttons")
        self.buttons = copy.deepcopy(btns if isinstance(btns, list) else DEFAULT_CONFIG["buttons"])
        self.buttons_saved = copy.deepcopy(self.buttons)

        _install_settings_css()
        win = self.win = Gtk.Window(title="kde-keybar settings")
        win.add_css_class("kde-keybar-settings")
        g = _monitor_geometry()
        w, h = (g.width, g.height) if g is not None else (1000, 900)
        win.set_default_size(min(960, max(360, w - 40)), min(1000, max(400, h - 120)))
        win.connect("close-request", self._closed)

        self.notebook = Gtk.Notebook()
        self.notebook.set_vexpand(True)
        self.notebook.append_page(self._fields_page(GENERAL_FIELDS), Gtk.Label(label="General"))
        self.notebook.append_page(self._fields_page(DICTATION_FIELDS), Gtk.Label(label="Dictation"))
        self.notebook.append_page(self._buttons_page(), Gtk.Label(label="Buttons"))
        if tab in SETTINGS_TABS:
            self.notebook.set_current_page(SETTINGS_TABS.index(tab))

        self.status = Gtk.Label(xalign=0, wrap=True, selectable=True)
        status_scroll = Gtk.ScrolledWindow()
        status_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        status_scroll.set_max_content_height(140)
        status_scroll.set_propagate_natural_height(True)
        status_scroll.set_child(self.status)
        status_scroll.set_hexpand(True)

        actions = Gtk.Box(spacing=8)
        cancel = Gtk.Button(label="Cancel")
        self.apply_btn = Gtk.Button(label="Apply")
        self.save_btn = Gtk.Button(label="Save")
        self.save_btn.add_css_class("suggested-action")
        for b in (cancel, self.apply_btn, self.save_btn):
            b.set_size_request(110, -1)
            actions.append(b)
        cancel.connect("clicked", lambda _b: win.close())
        self.apply_btn.connect("clicked", lambda _b: self.save())
        self.save_btn.connect("clicked", lambda _b: self.save() and win.close())

        footer = Gtk.Box(spacing=12)
        for m in ("top", "bottom", "start", "end"):
            getattr(footer, f"set_margin_{m}")(12)
        footer.append(status_scroll)
        actions.set_valign(Gtk.Align.END)
        footer.append(actions)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        root.append(self.notebook)
        root.append(Gtk.Separator())
        root.append(footer)
        win.set_child(root)

        if self.load_error:
            self.apply_btn.set_sensitive(False)
            self.save_btn.set_sensitive(False)
            self._show_status([self.load_error], [])
        else:
            self._show_status([], [], f"Editing {path}")
        win.present()

    def present(self):
        self.win.present()

    def _closed(self, _win):
        if self.on_closed:
            self.on_closed()
        return False

    # -- General / Dictation: one row per field spec --

    def _page(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        for m in ("top", "bottom", "start", "end"):
            getattr(box, f"set_margin_{m}")(16)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_child(box)
        return scroll, box

    def _fields_page(self, fields):
        scroll, box = self._page()
        for spec in fields:
            if spec.get("section"):
                head = Gtk.Label(label=spec["section"], xalign=0)
                head.add_css_class("section-title")
                box.append(head)
            box.append(self._field_row(spec))
        return scroll

    def _field_row(self, spec):
        key, kind = spec["key"], spec["type"]
        default = spec["default"] if "default" in spec else cfg_get(DEFAULT_CONFIG, key, None)
        value = cfg_get(self.data, key, _MISSING)
        missing = value is _MISSING
        if missing:
            value = default

        def commit(v):
            cfg_set(self.data, key, v)

        def unset():
            cfg_del(self.data, key)

        wide = kind in ("path", "keys", "argv")
        row = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL if wide else Gtk.Orientation.HORIZONTAL,
            spacing=8 if wide else 16,
        )
        row.add_css_class("field")
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        text.set_hexpand(True)
        title = Gtk.Label(label=spec["label"], xalign=0, wrap=True)
        title.add_css_class("field-title")
        text.append(title)
        if spec.get("help"):
            hl = Gtk.Label(label=spec["help"], xalign=0, wrap=True)
            hl.add_css_class("dim-label")
            text.append(hl)
        row.append(text)

        if kind == "choice":
            choices = list(spec["choices"])
            labels = list(spec.get("labels") or [str(c) for c in choices])
            idx = _index_of(choices, value)
            if idx < 0:  # a value the list does not know (e.g. dock: true): keep it selectable
                choices.append(value)
                labels.append(f"{json.dumps(value, ensure_ascii=False)} (current)")
                idx = len(choices) - 1
            ctl = _dropdown(labels, idx)
            ctl.set_size_request(300, -1)
            ctl.connect("notify::selected", lambda d, _p: commit(choices[d.get_selected()]))
        elif kind == "bool":
            ctl = Gtk.Switch(active=bool(value))
            ctl.connect("notify::active", lambda s, _p: commit(s.get_active()))
        elif kind in ("int", "float"):
            ctl = self._number(spec, value, missing, commit, unset)
        elif kind == "text":
            ctl = Gtk.Entry(text="" if value is None else str(value))
            ctl.set_size_request(300, -1)
            if spec.get("optional"):
                ctl.set_placeholder_text("theme default" if key.startswith("style.") else "default")

            def on_text(e):
                t = e.get_text()
                unset() if spec.get("optional") and not t else commit(t)

            ctl.connect("changed", on_text)
        elif kind == "path":
            ctl = Gtk.Box(spacing=8)
            entry = Gtk.Entry(text="" if value is None else str(value))
            entry.set_hexpand(True)
            entry.connect("changed", lambda e: commit(e.get_text()))
            ctl.append(entry)
            if hasattr(Gtk, "FileDialog"):
                browse = Gtk.Button(label="Browse…")
                browse.connect(
                    "clicked",
                    lambda _b: self._choose_file(entry, spec["label"], spec.get("folder", False)),
                )
                ctl.append(browse)
        elif kind == "keys":
            ctl = chord_editor(value or [], commit)
        elif kind == "argv":
            tv = Gtk.TextView()
            tv.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
            tv.get_buffer().set_text("\n".join(str(a) for a in (value or [])))
            for m in ("top", "bottom", "left", "right"):
                getattr(tv, f"set_{m}_margin")(8)

            def on_argv(buf):
                t = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False)
                commit([ln for ln in t.split("\n") if ln.strip()])

            tv.get_buffer().connect("changed", on_argv)
            ctl = Gtk.Frame(child=tv)
            ctl.set_size_request(-1, 150)
        else:
            raise ValueError(f"unknown field type {kind!r} for {key}")
        if not wide:
            ctl.set_valign(Gtk.Align.CENTER)
        row.append(ctl)
        return row

    def _number(self, spec, value, missing, commit, unset):
        is_int = spec["type"] == "int"
        lo, hi = spec.get("min", -1_000_000), spec.get("max", 1_000_000)
        spin = Gtk.SpinButton.new_with_range(lo, hi, spec.get("step", 1))
        spin.set_digits(0 if is_int else spec.get("digits", 2))
        spin.set_width_chars(7)
        ok = isinstance(value, (int, float)) and not isinstance(value, bool)
        fallback = spec.get("default", lo if lo > 0 else 0)
        spin.set_value(value if ok else (fallback if isinstance(fallback, (int, float)) else 0))

        def current():
            v = spin.get_value()
            return int(round(v)) if is_int else round(v, spec.get("digits", 2))

        caption = spec.get("nullable") or spec.get("optional")
        if not caption:
            spin.connect("value-changed", lambda _s: commit(current()))
            return spin
        box = Gtk.Box(spacing=12)
        check = Gtk.CheckButton(label=caption)
        is_off = (value is None) if spec.get("nullable") else missing
        check.set_active(is_off)
        spin.set_sensitive(not is_off)

        def on_check(c):
            spin.set_sensitive(not c.get_active())
            if not c.get_active():
                commit(current())
            elif spec.get("nullable"):
                commit(None)
            else:
                unset()

        check.connect("toggled", on_check)
        spin.connect("value-changed", lambda _s: check.get_active() or commit(current()))
        box.append(check)
        box.append(spin)
        return box

    def _choose_file(self, entry, title="Choose a file", folder=False):
        """File (or, with folder=True, directory) picker that writes ~/-relative paths."""
        dlg = Gtk.FileDialog(title=title)
        cur = os.path.expanduser(entry.get_text())
        if os.path.exists(cur):
            dlg.set_initial_file(Gio.File.new_for_path(cur))
        elif os.path.isdir(os.path.dirname(cur)):
            dlg.set_initial_folder(Gio.File.new_for_path(os.path.dirname(cur)))

        def done(d, res):
            try:
                f = d.select_folder_finish(res) if folder else d.open_finish(res)
            except GLib.Error:
                return  # cancelled
            p = f.get_path() if f else None
            if p:
                home = os.path.expanduser("~")
                entry.set_text("~" + p[len(home) :] if p.startswith(home + os.sep) else p)

        if folder:
            dlg.select_folder(self.win, None, done)
        else:
            dlg.open(self.win, None, done)

    # -- Buttons --

    def _buttons_page(self):
        scroll, box = self._page()
        self.btn_scroll = scroll
        intro = Gtk.Label(
            xalign=0,
            wrap=True,
            label="Buttons from left to right. Keys are pressed in order and released in "
            "reverse. Without a Settings (⚙) button this window is only reachable with "
            "kde-keybar --settings.",
        )
        intro.add_css_class("dim-label")
        box.append(intro)
        self.btn_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.btn_list.set_margin_top(10)
        box.append(self.btn_list)
        add = Gtk.Button(label="Add button")
        add.set_margin_top(12)
        add.set_halign(Gtk.Align.START)
        add.connect("clicked", lambda _b: self._add_button())
        box.append(add)
        self._render_buttons()
        return scroll

    def _render_buttons(self, scroll_to_end=False):
        adj = self.btn_scroll.get_vadjustment()
        pos = adj.get_value()
        _clear(self.btn_list)
        for i, b in enumerate(self.buttons):
            self.btn_list.append(self._button_card(i, b))

        def restore():
            adj.set_value(adj.get_upper() if scroll_to_end else pos)
            return False

        GLib.idle_add(restore)

    def _later(self, fn, *a):
        """Run fn after the current signal: re-rendering destroys the emitting widget."""
        GLib.idle_add(lambda: (fn(*a), self._render_buttons(), False)[2])

    def _add_button(self):
        self.buttons.append({"label": "Esc", "keys": ["ESC"]})
        self._render_buttons(scroll_to_end=True)

    def _move(self, i, d):
        j = i + d
        if 0 <= j < len(self.buttons):
            self.buttons[i], self.buttons[j] = self.buttons[j], self.buttons[i]

    def _set_kind(self, i, kind):
        b = self.buttons[i]
        keep = {k: v for k, v in b.items() if k not in ("keys", "modifier", "action", "repeat")}
        nb = {"label": b.get("label", ""), **keep}
        if kind == "keys":
            nb["keys"] = []
        elif kind == "modifier":
            nb["modifier"] = "LCTRL"
        else:
            nb["action"] = "dictate"
        self.buttons[i] = nb

    def _button_card(self, i, b):
        card = Gtk.Frame()
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        inner.add_css_class("button-card")
        card.set_child(inner)

        top = Gtk.Box(spacing=8)
        num = Gtk.Label(label=f"{i + 1}.")
        num.set_size_request(32, -1)
        top.append(num)

        def tool(icon, tip, fn, *a, sensitive=True):
            btn = Gtk.Button.new_from_icon_name(icon)
            btn.set_tooltip_text(tip)
            btn.set_size_request(48, -1)
            btn.set_sensitive(sensitive)
            btn.connect("clicked", lambda _b: self._later(fn, *a))
            return btn

        last = len(self.buttons) - 1
        if not isinstance(b, dict):
            bad = Gtk.Label(label=f"Not a button: {json.dumps(b, ensure_ascii=False)}", xalign=0)
            bad.add_css_class("error")
            bad.set_hexpand(True)
            top.append(bad)
        else:
            label = Gtk.Entry(text=str(b.get("label", "")), placeholder_text="Label")
            label.set_hexpand(True)
            label.connect("changed", lambda e: b.__setitem__("label", e.get_text()))
            top.append(label)
            kind = "modifier" if "modifier" in b else "action" if "action" in b else "keys"
            kinds = ["keys", "modifier", "action"]
            kdd = _dropdown(["Key chord", "One-shot modifier", "Action"], kinds.index(kind))
            kdd.connect(
                "notify::selected",
                lambda d, _p: self._later(self._set_kind, i, kinds[d.get_selected()]),
            )
            top.append(kdd)
        top.append(tool("go-up-symbolic", "Move left", self._move, i, -1, sensitive=i > 0))
        top.append(tool("go-down-symbolic", "Move right", self._move, i, 1, sensitive=i < last))
        top.append(tool("user-trash-symbolic", "Delete", self.buttons.pop, i))
        inner.append(top)
        if not isinstance(b, dict):
            return card

        def labelled(text, widget):
            row = Gtk.Box(spacing=12)
            lab = Gtk.Label(label=text, xalign=0)
            lab.set_size_request(110, -1)
            lab.set_valign(Gtk.Align.START)
            lab.set_margin_top(10)
            row.append(lab)
            widget.set_hexpand(True)
            row.append(widget)
            return row

        def set_or_pop(k, v):
            if v:
                b[k] = v
            else:
                b.pop(k, None)

        if kind == "keys":
            inner.append(
                labelled(
                    "Keys", chord_editor(b.get("keys") or [], lambda v: b.__setitem__("keys", v))
                )
            )
            rep = b.get("repeat")
            rdd = _dropdown(["Default", "On", "Off"], 0 if rep is None else 1 if rep else 2)
            rdd.set_hexpand(False)

            def on_repeat(d, _p):
                sel = d.get_selected()
                if sel == 0:
                    b.pop("repeat", None)
                else:
                    b["repeat"] = sel == 1

            rdd.connect("notify::selected", on_repeat)
            rbox = Gtk.Box()
            rbox.append(rdd)
            inner.append(labelled("Hold to repeat", rbox))
        elif kind == "modifier":
            mods = list(MODIFIER_NAMES)
            cur = str(b.get("modifier", "LCTRL"))
            if cur.upper() not in mods:
                mods.append(cur)
            mdd = _dropdown(mods, mods.index(cur.upper() if cur.upper() in mods else cur))
            mdd.connect(
                "notify::selected", lambda d, _p: b.__setitem__("modifier", mods[d.get_selected()])
            )
            mbox = Gtk.Box()
            mbox.append(mdd)
            inner.append(labelled("Modifier", mbox))
            grid = chord_editor(b.get("keys") or [], lambda v: set_or_pop("keys", v), "(all keys)")
            inner.append(labelled("Grid keys", grid))
        else:
            acts = sorted(BUTTON_ACTIONS)
            cur = b.get("action")
            if cur not in acts:
                acts.append(cur)
            add = _dropdown([ACTION_LABELS.get(a, str(a)) for a in acts], acts.index(cur))
            add.connect(
                "notify::selected", lambda d, _p: b.__setitem__("action", acts[d.get_selected()])
            )
            abox = Gtk.Box()
            abox.append(add)
            inner.append(labelled("Action", abox))
        return card

    # -- saving --

    def collect(self):
        """The config as it would be saved."""
        data = copy.deepcopy(self.data)
        if self.buttons != self.buttons_saved:
            data["buttons"] = copy.deepcopy(self.buttons)
        return data

    def _show_status(self, errs, warns, note=None, ok=False):
        def line(color, text):
            return f'<span foreground="{color}">{GLib.markup_escape_text(text)}</span>'

        lines = [line("#e5484d", f"Error: {e}") for e in errs]
        lines += [line("#d9822b", f"Warning: {w}") for w in warns]
        if note:
            lines.append(line("#30a46c", note) if ok else GLib.markup_escape_text(note))
        self.status.set_markup("\n".join(lines))

    def save(self):
        """Validate and write. Returns True when the file was written."""
        if self.load_error:
            return False
        data = self.collect()
        errs, warns = validate_config_data(data)
        if errs:
            self._show_status(errs, warns, "Not saved.")
            return False
        try:
            real = save_config(self.path, data)
        except OSError as e:
            self._show_status([f"could not write {self.path}: {e}"], warns)
            return False
        self.data = data
        self.buttons_saved = copy.deepcopy(self.buttons)
        where = real if real == os.path.abspath(self.path) else f"{real} (via {self.path})"
        self._show_status([], warns, f"Saved to {where}.", ok=True)
        if self.on_saved:
            self.on_saved(real)
        return True


_SETTINGS_CSS_DONE = []


def _install_settings_css():
    disp = Gdk.Display.get_default()
    if _SETTINGS_CSS_DONE or disp is None:
        return
    prov = Gtk.CssProvider()
    prov.load_from_string(SETTINGS_CSS)
    Gtk.StyleContext.add_provider_for_display(disp, prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    _SETTINGS_CSS_DONE.append(prov)


def run_settings(path, tab, loop):
    """kde-keybar --settings: just the settings window, no bar and no layer surface."""
    default = os.path.realpath(DEFAULT_CONFIG_PATH)

    def saved(real):
        # Only poke running bars when this is their config, so editing a test or example
        # file never reloads the bar you are using.
        if real == default:
            n = reload_running_instances()
            print(f"kde-keybar: saved {real}, reloaded {n} running instance(s)", file=sys.stderr)

    SettingsWindow(path, on_saved=saved, on_closed=loop.quit, tab=tab)
    # Another settings window saving sends SIGHUP to every kde-keybar; do not die from it.
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGHUP, lambda *a: True)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, lambda *a: loop.quit() or True)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, lambda *a: loop.quit() or True)
    loop.run()


def main(argv=None):
    ap = argparse.ArgumentParser(prog="kde-keybar", description=__doc__.strip().splitlines()[0])
    ap.add_argument("-c", "--config", default=DEFAULT_CONFIG_PATH, help="path to config JSON")
    ap.add_argument("--list-themes", action="store_true", help="list built-in themes and exit")
    ap.add_argument("--validate", action="store_true", help="check the config for errors and exit")
    ap.add_argument(
        "--reload",
        action="store_true",
        help="tell running instances to reload their config, then exit",
    )
    ap.add_argument(
        "--settings",
        nargs="?",
        const="general",
        choices=SETTINGS_TABS,
        metavar="TAB",
        help="open only the settings window (optionally on general, dictation or buttons)",
    )
    ap.add_argument("-V", "--version", action="version", version=f"kde-keybar {__version__}")
    args = ap.parse_args(argv)

    if args.list_themes:
        print('Built-in themes (set "theme": "<name>" in the config):')
        for name in THEMES:
            print(f"  {name}")
        return

    if args.validate:
        errs, warns = validate_config(args.config)
        for w in warns:
            print(f"warning: {w}")
        for e in errs:
            print(f"error: {e}")
        if errs:
            print(f"{args.config}: {len(errs)} error(s), {len(warns)} warning(s)")
            sys.exit(1)
        print(f"{args.config}: OK" + (f" ({len(warns)} warning(s))" if warns else ""))
        return

    if args.reload:
        print(f"sent reload to {reload_running_instances()} running instance(s)")
        return

    Gtk.init()
    loop = GLib.MainLoop()

    if args.settings:
        run_settings(args.config, args.settings, loop)
        return

    state = {}
    setup_visibility(state)

    def open_settings():
        if state.get("settings"):
            state["settings"].present()
            return
        state["settings"] = SettingsWindow(
            args.config,
            on_saved=lambda _real: rebuild(),
            on_closed=lambda: state.pop("settings", None),
        )

    def rebuild(*_):
        win = None
        try:
            cfg = load_config(args.config)
            send = make_sender(cfg)
            dictation = Dictation(cfg, send)
            win = build_window(cfg, send, dictation, on_settings=open_settings)
            apply_css(cfg, win.get_display(), state)
        except Exception as e:
            print(f"kde-keybar: reload failed, keeping current config ({e})", file=sys.stderr)
            if win is not None:
                win.destroy()
            return False
        old = state.get("win")
        if state.get("dictation"):
            state["dictation"].cancel()
        state["dictation"] = dictation
        dictation.listen()
        state["win"] = win
        state["cfg"] = cfg
        state["always"] = bool(cfg.get("visibility") == "always" or os.environ.get("KEYBAR_ALWAYS"))
        state["refresh_visibility"]()
        if old:
            old.destroy()
        return False

    rebuild()
    export_dbus(state)

    # The bottom margin (keyboard height estimate) and the bar width are computed from
    # the monitor geometry at build time, so rebuild when it changes (screen rotation,
    # resolution or scale change). Debounced: a rotation fires several notifications.
    def on_monitor_change(*_):
        if state.get("geom_timer"):
            GLib.source_remove(state["geom_timer"])

        def fire():
            global _KB_HEIGHT
            state["geom_timer"] = None
            _KB_HEIGHT = None  # old orientation's height; the KWin script resends it
            rebuild()
            return False

        state["geom_timer"] = GLib.timeout_add(300, fire)

    def hook_monitors(*_):
        mons = Gdk.Display.get_default().get_monitors()
        hooked = state.setdefault("hooked_monitors", set())
        for i in range(mons.get_n_items()):
            m = mons.get_item(i)
            if id(m) not in hooked:
                m.connect("notify::geometry", on_monitor_change)
                hooked.add(id(m))
        on_monitor_change()

    if Gdk.Display.get_default() is not None:
        monitors = Gdk.Display.get_default().get_monitors()
        monitors.connect("items-changed", hook_monitors)
        for i in range(monitors.get_n_items()):
            monitors.get_item(i).connect("notify::geometry", on_monitor_change)
            state.setdefault("hooked_monitors", set()).add(id(monitors.get_item(i)))

    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGHUP, lambda *a: rebuild() or True)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, lambda *a: loop.quit() or True)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, lambda *a: loop.quit() or True)

    # Auto-reload when the config file changes. Watch the directory to catch editor
    # rename-saves, and for a symlinked config also the target's directory: editing the
    # target (e.g. in a dotfiles repo) does not touch the link's directory at all.
    def on_change(_m, changed, _o, _e, name):
        if changed and changed.get_basename() == name:
            if state.get("reload_timer"):
                GLib.source_remove(state["reload_timer"])
            state["reload_timer"] = GLib.timeout_add(
                300, lambda: (state.pop("reload_timer", None), rebuild())[1]
            )

    state["monitors"] = []
    for watched in dict.fromkeys((os.path.abspath(args.config), os.path.realpath(args.config))):
        try:
            folder = Gio.File.new_for_path(os.path.dirname(watched))
            mon = folder.monitor_directory(Gio.FileMonitorFlags.NONE, None)
        except GLib.Error:
            continue
        mon.connect("changed", on_change, os.path.basename(watched))
        state["monitors"].append(mon)

    loop.run()
    if state.get("dictation"):
        state["dictation"].cancel()


if __name__ == "__main__":
    main()
