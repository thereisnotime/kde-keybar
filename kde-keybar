def validate_config(path):
    """Return (errors, warnings): errors are problems, warnings are advisory."""
    try:
        with open(path, encoding="utf-8") as f:
            cfg = json.load(f)
    except FileNotFoundError:
        return [], [f"config not found: {path} (built-in defaults will be used)"]
    except json.JSONDecodeError as e:
        return [f"invalid JSON: {e}"], []
    return validate_config_data(cfg)


def validate_config_data(cfg):
    """validate_config for an already parsed config (used by the settings window)."""
    errs, warns = [], []
    if not isinstance(cfg, dict):
        return ["the config must be a JSON object"], warns
    if cfg.get("theme", "dark") not in THEMES:
        errs.append(f"unknown theme '{cfg.get('theme')}'; valid: {', '.join(THEMES)}")
    if cfg.get("position", "bottom") not in ("bottom", "top"):
        errs.append("position must be 'bottom' or 'top'")
    if cfg.get("visibility", "keyboard") not in ("keyboard", "always"):
        errs.append("visibility must be 'keyboard' or 'always'")
    if cfg.get("overflow", "scroll") not in ("scroll", "wrap"):
        errs.append("overflow must be 'scroll' or 'wrap'")
    if cfg.get("layer", "overlay") not in ("overlay", "top", "bottom", "background"):
        errs.append("layer must be 'overlay', 'top', 'bottom', or 'background'")
    if "dock" in cfg and cfg["dock"] not in (True, False, "none", "bar", "keyboard"):
        errs.append('dock must be false, true, "bar", or "keyboard"')
    if cfg.get("monitor") is not None and not isinstance(cfg.get("monitor"), int):
        errs.append("monitor must be an integer or null")
    for k in (
        "font_px",
        "button_height_px",
        "button_min_width_px",
        "gap_px",
        "repeat_delay_ms",
        "repeat_interval_ms",
    ):
        if k in cfg and not isinstance(cfg[k], int):
            errs.append(f"{k} must be an integer")
    if cfg.get("margin_px") is not None and not isinstance(cfg.get("margin_px"), int):
        errs.append("margin_px must be an integer or null")
    for k in cfg.get("style", {}):
        if k not in STYLE_KEYS:
            warns.append(f"style: unknown key '{k}'")
    btns = cfg.get("buttons")
    if btns is None:
        warns.append("no 'buttons' set; defaults will be used")
    elif not isinstance(btns, list) or not btns:
        errs.append("'buttons' must be a non-empty list")
    else:
        for i, b in enumerate(btns):
            if isinstance(b, dict) and "modifier" in b:
                if KEYCODES.get(str(b["modifier"]).upper()) is None:
                    errs.append(f"button[{i}]: unknown modifier key '{b['modifier']}'")
                for kname in b.get("keys") or []:
                    if KEYCODES.get(str(kname).upper()) is None:
                        errs.append(f"button[{i}]: unknown key '{kname}'")
                continue
            if isinstance(b, dict) and "action" in b:
                if b["action"] not in BUTTON_ACTIONS:
                    errs.append(f"button[{i}]: unknown action '{b['action']}'")
                continue
            if not isinstance(b, dict) or "keys" not in b:
                errs.append(f"button[{i}] must be an object with 'keys' or 'action'")
                continue
            if "label" not in b:
                warns.append(f"button[{i}] has no 'label'")
            if "repeat" in b and not isinstance(b["repeat"], bool):
                errs.append(f"button[{i}]: repeat must be true or false")
            for kname in b.get("keys", []):
                if KEYCODES.get(kname) is None and KEYCODES.get(str(kname).upper()) is None:
                    errs.append(f"button[{i}] ({b.get('label', '?')}): unknown key '{kname}'")
    for kname in cfg.get("modifier_keys") or []:
        if KEYCODES.get(str(kname).upper()) is None:
            errs.append(f"modifier_keys: unknown key '{kname}'")
    dc = cfg.get("dictation")
    if dc is not None:
        if not isinstance(dc, dict):
            errs.append("dictation must be an object")
        else:
            for k in dc:
                if k not in DEFAULT_CONFIG["dictation"]:
                    warns.append(f"dictation: unknown key '{k}'")
            for k in ("record_command", "transcribe_command"):
                if k in dc and (not isinstance(dc[k], list) or not dc[k]):
                    errs.append(f"dictation.{k} must be a non-empty list (argv)")
            if dc.get("output", "type") not in ("type", "paste"):
                errs.append("dictation.output must be 'type' or 'paste'")
            if "max_seconds" in dc and not isinstance(dc["max_seconds"], int):
                errs.append("dictation.max_seconds must be an integer")
            sss = dc.get("silence_stop_seconds", 0)
            if isinstance(sss, bool) or not isinstance(sss, (int, float)) or sss < 0:
                errs.append("dictation.silence_stop_seconds must be a number >= 0")
            sl = dc.get("silence_level", 300)
            if isinstance(sl, bool) or not isinstance(sl, int) or not 0 <= sl <= 32767:
                errs.append("dictation.silence_level must be an integer 0-32767")
            ww = dc.get("wake_word")
            if ww is not None and not isinstance(ww, dict):
                errs.append("dictation.wake_word must be an object")
            elif ww is not None:
                for k in ww:
                    if k not in DEFAULT_CONFIG["dictation"]["wake_word"]:
                        warns.append(f"dictation.wake_word: unknown key '{k}'")
                if "enabled" in ww and not isinstance(ww["enabled"], bool):
                    errs.append("dictation.wake_word.enabled must be true or false")
                ph = ww.get("phrase", DEFAULT_CONFIG["dictation"]["wake_word"]["phrase"])
                if not isinstance(ph, str) or not ph.strip():
                    errs.append("dictation.wake_word.phrase must be a non-empty string")
                elif len(ph.split()) == 1:
                    warns.append(
                        "dictation.wake_word.phrase: a single word fires on a lot of ordinary "
                        "speech; two words work much better"
                    )
                for k in ("model", "python"):
                    if k in ww and (not isinstance(ww[k], str) or not ww[k].strip()):
                        errs.append(f"dictation.wake_word.{k} must be a non-empty path")
    return errs, warns


def apply_bottom_margin(win, cfg):
    """Re-apply the bottom margin (and keyboard dock zone) to a live window."""
    if cfg.get("position") == "top":
        return
    GtkLayerShell.set_margin(win, GtkLayerShell.Edge.BOTTOM, bottom_margin_px(cfg))
    if cfg.get("dock") == "keyboard":
        bar_h = _int(cfg.get("button_height_px", 54), 54) + 8
        GtkLayerShell.set_exclusive_zone(win, bottom_margin_px(cfg) + bar_h)


def export_dbus(state):
    """Own DBUS_NAME so the KWin script can report the real keyboard height."""
    node = Gio.DBusNodeInfo.new_for_xml(DBUS_XML)

    def on_call(_conn, _sender, _path, _iface, method, params, invocation):
        global _KB_HEIGHT
        if method != "SetKeyboardHeight":
            invocation.return_dbus_error(f"{DBUS_NAME}.Error", f"unknown method {method}")
            return
        (height,) = params.unpack()
        invocation.return_value(None)
        if height <= 0 or (_KB_HEIGHT is not None and abs(height - _KB_HEIGHT) < 1):
            return
        _KB_HEIGHT = height
        win, cfg = state.get("win"), state.get("cfg")
        if win is not None and cfg is not None and cfg.get("margin_px") is None:
            apply_bottom_margin(win, cfg)

    def on_bus(conn, _name):
        conn.register_object(DBUS_PATH, node.interfaces[0], on_call, None, None)

    Gio.bus_own_name(Gio.BusType.SESSION, DBUS_NAME, Gio.BusNameOwnerFlags.NONE, on_bus, None, None)


def reload_running_instances():
    """Send SIGHUP to other kde-keybar processes so they reload their config."""
    me = os.getpid()
    sent = 0
    for pid in os.listdir("/proc"):
        if not pid.isdigit() or int(pid) == me:
            continue
        try:
            cmd = open(f"/proc/{pid}/cmdline", "rb").read()
        except OSError:
            continue
        # Match the program itself (argv[0], or argv[1] under an interpreter), not any
        # process that merely mentions kde-keybar somewhere in its command line.
        args = [os.path.basename(a) for a in cmd.split(b"\0")[:2]]
        if b"kde-keybar" in args:
            try:
                os.kill(int(pid), signal.SIGHUP)
                sent += 1
            except OSError:
                pass
    return sent


