def load_config(path):
    cfg = dict(DEFAULT_CONFIG)
    try:
        with open(path) as f:
            cfg.update(json.load(f))
    except FileNotFoundError:
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "w") as f:
                json.dump(DEFAULT_CONFIG, f, indent=2, ensure_ascii=False)
            print(f"kde-keybar: wrote default config to {path}", file=sys.stderr)
        except OSError:
            pass
    except (json.JSONDecodeError, OSError) as e:
        print(f"kde-keybar: bad config {path}: {e}; using defaults", file=sys.stderr)
    return cfg


def resolve_keys(names):
    codes = []
    for n in names:
        c = KEYCODES.get(n) or KEYCODES.get(str(n).upper())
        if c is None:
            print(f"kde-keybar: unknown key '{n}'", file=sys.stderr)
        else:
            codes.append(c)
    return codes


def make_sender(cfg):
    socket = os.environ.get("YDOTOOL_SOCKET", cfg["ydotool_socket"])

    def send(codes):
        seq = [f"{c}:1" for c in codes] + [f"{c}:0" for c in reversed(codes)]
        try:
            subprocess.Popen(["ydotool", "key", *seq], env=dict(os.environ, YDOTOOL_SOCKET=socket))
        except FileNotFoundError:
            print("kde-keybar: ydotool not found on PATH", file=sys.stderr)

    return send


class Dictation:
    """Toggle-to-talk: first tap records, second tap stops, transcribes, and types.

    Everything runs off the GLib main loop (Gio.Subprocess), so the bar never blocks
    while the model is working. One instance per window build; cancel() on reload."""

    IDLE, RECORDING, TRANSCRIBING = range(3)

    def __init__(self, cfg, send):
        self.dc = {**DEFAULT_CONFIG["dictation"], **(cfg.get("dictation") or {})}
        self.send = send
        self.socket = os.environ.get("YDOTOOL_SOCKET", cfg["ydotool_socket"])
        self.state = self.IDLE
        self.rec = None
        self.wav = None
        self.timer = None
        self.watch = None  # silence auto-stop poller
        self.buttons = []  # (button, idle_label)
        self.woken = False  # this recording was started by the wake word
        self.wake = None  # WakeWord listener, when dictation.wake_word.enabled

    def listen(self):
        """Start the wake-word listener if it's enabled. Called once the window that
        owns this instance is live, so a failed rebuild never leaves a helper behind."""
        user = self.dc.get("wake_word")
        ww = {
            **DEFAULT_CONFIG["dictation"]["wake_word"],
            **(user if isinstance(user, dict) else {}),
        }
        if ww.get("enabled") is True and self.wake is None:
            self.wake = WakeWord(self, ww)
            self.wake.start()

    def wake_heard(self):
        # Only an idle bar reacts: the phrase said mid-dictation is just dictation.
        if self.state != self.IDLE:
            return
        print("kde-keybar: dictation: wake word heard", file=sys.stderr)
        self.start(woken=True)

    def attach(self, button):
        self.buttons.append((button, button.get_label()))
        button.connect("clicked", lambda _b: self.toggle())

    def _show(self, label=None, css=None):
        for b, idle in self.buttons:
            b.set_label(label or idle)
            for c in ("dictating", "transcribing"):
                b.remove_css_class(c)
            if css:
                b.add_css_class(css)

    def _flash(self, msg):
        print(f"kde-keybar: dictation: {msg}", file=sys.stderr)
        self._show(msg)
        GLib.timeout_add_seconds(2, lambda: (self.state == self.IDLE and self._show(), False)[1])

    def audio_ctx(self):
        """Whisper encoder context for this clip. Whisper always encodes a 30 s window
        (1500 frames) even for a 3 s clip; sizing it to the clip (plus headroom, and a
        floor because very small contexts hurt accuracy) cuts encode time several-fold."""
        try:
            secs = max(0, os.path.getsize(self.wav) - 44) / 32000  # 16 kHz mono s16
        except (OSError, TypeError):
            return 1500
        # Floor of 768: at 384-512 base.en mishears short clips ("above the" -> "a month
        # of"); 768 fixes that for about 1 s more on a 5 s clip.
        return max(768, min(1500, int(secs * 50) + 128))

    def _fill(self, argv):
        subs = {
            "{wav}": self.wav or "",
            "{model}": os.path.expanduser(str(self.dc.get("model", ""))),
            "{language}": str(self.dc.get("language", "en")),
            "{audio_ctx}": str(self.audio_ctx()) if self.wav else "1500",
        }
        out = []
        for a in argv:
            a = str(a)
            for k, v in subs.items():
                a = a.replace(k, v)
            out.append(a)
        return out

    def toggle(self):
        if self.state == self.IDLE:
            self.start()
        elif self.state == self.RECORDING:
            self.stop()
        # taps while transcribing are ignored

    def start(self, woken=False):
        model = os.path.expanduser(str(self.dc.get("model", "")))
        if "{model}" in " ".join(map(str, self.dc["transcribe_command"])) and not os.path.isfile(
            model
        ):
            self._flash("no model")
            print(f"  expected a model at {model} (try: just setup-dictation)", file=sys.stderr)
            return
        rundir = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
        fd, self.wav = tempfile.mkstemp(prefix="kde-keybar-", suffix=".wav", dir=rundir)
        os.close(fd)
        try:
            self.rec = Gio.Subprocess.new(
                self._fill(self.dc["record_command"]), Gio.SubprocessFlags.STDERR_SILENCE
            )
        except GLib.Error as e:
            self._cleanup()
            self._flash("no mic")
            print(f"  record_command failed: {e.message}", file=sys.stderr)
            return
        self.state = self.RECORDING
        self.woken = woken
        self._show("● Rec", "dictating")
        max_s = _int(self.dc.get("max_seconds", 120), 120)
        if max_s > 0:
            self.timer = GLib.timeout_add_seconds(max_s, self._timeout)
        if self.silence_stop() > 0 or woken:
            self.read_pos, self.heard, self.quiet, self.listened = None, False, 0.0, 0.0
            self.watch = GLib.timeout_add(self.WATCH_MS, self._watch)

    WATCH_MS = 150
    # A wake-word recording that hears nothing for this long was a false alarm (or you
    # changed your mind): drop it instead of recording until max_seconds.
    WAKE_LISTEN_S = 5.0
    RATE = 16000  # what the default record_command writes; auto-stop assumes it

    def silence_stop(self):
        try:
            return max(0.0, float(self.dc.get("silence_stop_seconds") or 0))
        except (TypeError, ValueError):
            return 0.0

    def silence_level(self):
        return _int(self.dc.get("silence_level", 300), 300)

    def _stop_watch(self):
        if self.watch:
            GLib.source_remove(self.watch)
            self.watch = None

    def _watch(self):
        """Poll the growing WAV: after speech has been heard, stop once it has been
        quiet for silence_stop_seconds. Reads only the bytes added since last tick."""
        if self.state != self.RECORDING or not self.wav:
            self.watch = None
            return False
        try:
            with open(self.wav, "rb") as f:
                if self.read_pos is None:
                    head = f.read(512)
                    i = head.find(b"data")
                    if i < 0 or len(head) < i + 8:
                        return True  # header not written yet
                    self.read_pos = i + 8
                f.seek(self.read_pos)
                data = f.read()
        except OSError:
            return True
        data = data[: len(data) - len(data) % 2]
        if not data:
            return True
        self.read_pos += len(data)
        samples = array("h", data)
        if sys.byteorder == "big":
            samples.byteswap()
        level, block = self.silence_level(), self.RATE // 10  # judge in 100 ms slices
        for i in range(0, len(samples), block):
            chunk = samples[i : i + block]
            if max(map(abs, chunk)) >= level:
                self.heard, self.quiet = True, 0.0
            elif self.heard:
                self.quiet += len(chunk) / self.RATE
        self.listened += len(samples) / self.RATE
        if self.heard and 0 < self.silence_stop() <= self.quiet:
            self.watch = None
            self.stop()
            return False
        if self.woken and not self.heard and self.listened >= self.WAKE_LISTEN_S:
            self.watch = None
            self._abort()
            self._flash("no speech")
            return False
        return True

    def _timeout(self):
        self.timer = None
        if self.state == self.RECORDING:
            self.stop()
        return False

    def stop(self):
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = None
        self._stop_watch()
        self.state = self.TRANSCRIBING
        self._show("…", "transcribing")
        # SIGINT lets parecord / pw-record flush and finalize the WAV header.
        self.rec.send_signal(signal.SIGINT)
        self.rec.wait_async(None, self._recorded)

    def _recorded(self, proc, res):
        try:
            proc.wait_finish(res)
        except GLib.Error:
            pass
        self.rec = None
        if self.state != self.TRANSCRIBING:  # cancelled meanwhile
            return
        if self.is_silent(self.wav, self.silence_level()):
            # Whisper hallucinates on silence ("you", "Thank you."), so never feed it a
            # dead clip. Usually means the mic source is muted or the wrong one.
            self._done()
            self._flash("mic silent")
            print("  recording is silent: is the default source muted? (pactl)", file=sys.stderr)
            return
        try:
            tr = Gio.Subprocess.new(
                self._fill(self.dc["transcribe_command"]),
                Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE,
            )
        except GLib.Error as e:
            self._done()
            self._flash("no STT")
            print(f"  transcribe_command failed: {e.message}", file=sys.stderr)
            return
        tr.communicate_utf8_async(None, None, self._transcribed)

    def _transcribed(self, proc, res):
        try:
            _ok, out, _err = proc.communicate_utf8_finish(res)
        except GLib.Error as e:
            out = ""
            print(f"kde-keybar: dictation: {e.message}", file=sys.stderr)
        if self.state != self.TRANSCRIBING:
            return
        print(f"kde-keybar: dictation: whisper said {out!r}", file=sys.stderr)
        self._done()
        text = self.clean(out or "")
        if not text:
            self._flash("(nothing)")
            return
        self.emit(text)

    @staticmethod
    def is_silent(path, level=300):
        """True if the 16-bit WAV never rises above the silence floor. Unreadable or
        non-16-bit files count as not silent, so custom record commands still work."""
        try:
            with wave.open(path, "rb") as w:
                if w.getsampwidth() != 2:
                    return False
                frames = w.readframes(w.getnframes())
        except (OSError, EOFError, wave.Error, TypeError):
            return False
        samples = array("h", frames[: len(frames) - len(frames) % 2])
        if sys.byteorder == "big":
            samples.byteswap()
        return not samples or max(map(abs, samples)) < level

    @staticmethod
    def clean(out):
        """Join model output into one line and drop non-speech tags like [BLANK_AUDIO]."""
        words = []
        for line in out.splitlines():
            line = line.strip()
            if not line or (line[0] in "[(" and line[-1] in "])"):
                continue
            words.append(line)
        text = " ".join(words).strip()
        # Whisper sometimes loops and emits the same sentence twice in a row; nobody
        # dictates an identical sentence back to back, so collapse those repeats.
        out_sents = []
        for sent in re.split(r"(?<=[.!?])\s+", text):
            if not out_sents or sent.strip().lower() != out_sents[-1].strip().lower():
                out_sents.append(sent)
        return " ".join(out_sents)

    def emit(self, text):
        print(f"kde-keybar: dictation: typing {text!r}", file=sys.stderr)
        env = dict(os.environ, YDOTOOL_SOCKET=self.socket)
        try:
            if self.dc.get("output") == "paste":
                subprocess.run(["wl-copy", "--", text], check=True, timeout=5)
                codes = resolve_keys(self.dc.get("paste_keys") or ["LCTRL", "V"])
                GLib.timeout_add(80, lambda: (self.send(codes), False)[1])
            else:
                subprocess.Popen(["ydotool", "type", "--", text], env=env)
        except (OSError, subprocess.SubprocessError) as e:
            self._flash("type failed")
            print(f"  {e}", file=sys.stderr)

    def _done(self):
        self.state = self.IDLE
        self._cleanup()
        self._show()

    def _cleanup(self):
        if self.wav:
            # Keep only the latest clip (runtime dir: tmpfs, user-only, gone at logout)
            # so a bad transcript can be replayed with the transcribe_command.
            last = os.path.join(os.path.dirname(self.wav), "kde-keybar-last.wav")
            try:
                os.replace(self.wav, last)
            except OSError:
                try:
                    os.unlink(self.wav)
                except OSError:
                    pass
            self.wav = None

    def cancel(self):
        """Drop any in-flight recording and stop the wake-word listener (used when the
        window is rebuilt and on exit)."""
        if self.wake:
            self.wake.stop()
            self.wake = None
        self._abort()

    def _abort(self):
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = None
        self._stop_watch()
        if self.rec:
            self.rec.force_exit()
            self.rec = None
        self.state = self.IDLE
        self.woken = False
        self._cleanup()


class WakeWord:
    """Runs kde-keybar-wake (Vosk, in its own venv) and starts a dictation on each "wake"
    line it prints. Its stdout is read asynchronously on the GLib main loop. A helper
    that dies is restarted with backoff; a setup problem (no venv, model, or helper)
    is reported once and not retried until the next config reload."""

    SETUP_ERROR = 3  # kde-keybar-wake's exit status for "retrying won't help"
    MAX_BACKOFF_S = 60

    def __init__(self, dictation, ww):
        self.dictation = dictation
        self.ww = ww
        self.proc = None
        self.cancellable = None
        self.retry = None
        self.backoff = 1
        self.started = 0
        self.stopped = False

    @staticmethod
    def helper_path():
        # Installed side by side (/usr/bin/kde-keybar-wake), or next to the checkout.
        here = os.path.dirname(os.path.realpath(__file__))
        return os.path.join(here, "kde-keybar-wake")

    def argv(self):
        return [
            os.path.expanduser(str(self.ww.get("python") or "")),
            self.helper_path(),
            "--phrase",
            str(self.ww.get("phrase") or ""),
            "--model",
            os.path.expanduser(str(self.ww.get("model") or "")),
        ]

    def _setup_error(self, why):
        self.dictation._flash("no wake")
        print(f"kde-keybar: wake word: {why}", file=sys.stderr)

    def start(self):
        if self.stopped:
            return False
        self.retry = None
        argv = self.argv()
        if not os.access(argv[0], os.X_OK):
            self._setup_error(f"no Python at {argv[0]} (run: just setup-wakeword)")
            return False
        if not os.path.isfile(self.helper_path()):
            self._setup_error(f"helper not found at {self.helper_path()}")
            return False
        try:
            self.proc = Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDOUT_PIPE)
        except GLib.Error as e:
            self._setup_error(f"could not start the helper: {e.message}")
            return False
        self.started = GLib.get_monotonic_time()
        self.cancellable = Gio.Cancellable()
        stream = Gio.DataInputStream.new(self.proc.get_stdout_pipe())
        self._read(stream)
        self.proc.wait_async(self.cancellable, self._exited)
        return False

    def _read(self, stream):
        stream.read_line_async(GLib.PRIORITY_DEFAULT, self.cancellable, self._line)

    def _line(self, stream, res):
        try:
            line, _n = stream.read_line_finish_utf8(res)
        except GLib.Error:
            return  # cancelled, or the pipe broke; _exited handles the restart
        if line is None:
            return  # EOF
        if line.strip() == "wake" and not self.stopped:
            self.dictation.wake_heard()
        self._read(stream)

    def _exited(self, proc, res):
        try:
            proc.wait_finish(res)
        except GLib.Error:
            return  # cancelled by stop()
        self.proc = None
        if self.stopped:
            return
        code = proc.get_exit_status() if proc.get_if_exited() else -proc.get_term_sig()
        if code == self.SETUP_ERROR:
            self._setup_error("helper gave up (see its message above)")
            return
        # A helper that ran for a while before dying gets a fresh backoff.
        if GLib.get_monotonic_time() - self.started > 60_000_000:
            self.backoff = 1
        print(
            f"kde-keybar: wake word: helper exited ({code}), restarting in {self.backoff} s",
            file=sys.stderr,
        )
        self.retry = GLib.timeout_add_seconds(self.backoff, self.start)
        self.backoff = min(self.backoff * 2, self.MAX_BACKOFF_S)

    def stop(self):
        self.stopped = True
        if self.retry:
            GLib.source_remove(self.retry)
            self.retry = None
        if self.cancellable:
            self.cancellable.cancel()
        if self.proc:
            self.proc.send_signal(signal.SIGTERM)
            self.proc = None


def _int(v, default):
    """int(v) but falls back to default on bad values (keeps a bad config non-fatal)."""
    try:
        return int(v)
    except (TypeError, ValueError):
        return default


def _monitor_geometry():
    """Geometry of the first monitor (GTK4 Gdk API), or None."""
    disp = Gdk.Display.get_default()
    monitors = disp.get_monitors() if disp else None
    if not monitors or monitors.get_n_items() == 0:
        return None
    return monitors.get_item(0).get_geometry()


# Real on-screen keyboard height (logical px) as reported over D-Bus by the kde-keybar-fit
# KWin script. Maliit's height changes (suggestion row, rotation), so when this is known
# it beats the keyboard_height_fraction estimate.
_KB_HEIGHT = None

DBUS_NAME = "io.github.thereisnotime.KdeKeybar"
DBUS_PATH = "/io/github/thereisnotime/KdeKeybar"
DBUS_XML = f"""<node>
  <interface name="{DBUS_NAME}">
    <method name="SetKeyboardHeight"><arg type="d" name="height" direction="in"/></method>
  </interface>
</node>"""


def bottom_margin_px(cfg):
    env = os.environ.get("KEYBAR_MARGIN")
    if env and env.lstrip("-").isdigit():
        return int(env)
    gap = _int(cfg.get("gap_px", 0), 0)
    if cfg.get("margin_px") is not None:
        return _int(cfg["margin_px"], 0) + gap
    # In always mode there is no on-screen keyboard to sit above, so hug the edge.
    if cfg.get("visibility") == "always" or os.environ.get("KEYBAR_ALWAYS"):
        return gap
    if _KB_HEIGHT is not None:
        return int(round(_KB_HEIGHT)) + gap
    try:
        g = _monitor_geometry()
        if g is None:
            return 320 + gap
        portrait = g.height > g.width
        fr = cfg["keyboard_height_fraction"]
        frac = fr["portrait"] if portrait else fr["landscape"]
        return int(g.height * frac) + gap
    except Exception:
        return 320 + gap


def attach_repeat(button, codes, send, cfg):
    """Press-and-hold auto-repeat that leaves GtkButton's own gesture alone.

    A tap still sends once via "clicked". While the button stays :active (finger or
    mouse down) for repeat_delay_ms, it starts repeating every repeat_interval_ms; the
    release that ends a repeat run does not send again. Watching :active instead of
    adding a GestureClick matters: a second gesture would either fight the button or
    claim the touch (breaking swipe-to-scroll), and GestureClick also emits "stopped"
    when its double-click timeout expires, which killed the repeat mid-hold. A swipe
    that turns into a scroll cancels the button, clears :active, and stops the repeat."""
    delay = max(50, _int(cfg.get("repeat_delay_ms", 400), 400))
    interval = max(15, _int(cfg.get("repeat_interval_ms", 50), 50))
    st = {"timer": None, "held": False, "repeated": False}

    def stop():
        if st["timer"]:
            GLib.source_remove(st["timer"])
            st["timer"] = None

    def tick():
        send(codes)
        st["repeated"] = True
        st["timer"] = GLib.timeout_add(interval, tick)
        return False

    def first():
        st["timer"] = None
        return tick()

    def on_flags(b, _prev):
        active = bool(b.get_state_flags() & Gtk.StateFlags.ACTIVE)
        if active and not st["held"]:
            st["held"], st["repeated"] = True, False
            stop()
            st["timer"] = GLib.timeout_add(delay, first)
        elif not active and st["held"]:
            st["held"] = False
            stop()

    def on_clicked(_b):
        if st["repeated"]:
            st["repeated"] = False
            return
        send(codes)

    button.connect("state-flags-changed", on_flags)
    button.connect("clicked", on_clicked)
    button.connect("unrealize", lambda *_: stop())


def build_window(cfg, send, dictation=None):
    win = Gtk.Window()
    GtkLayerShell.init_for_window(win)
    layers = {
        "background": GtkLayerShell.Layer.BACKGROUND,
        "bottom": GtkLayerShell.Layer.BOTTOM,
        "top": GtkLayerShell.Layer.TOP,
        "overlay": GtkLayerShell.Layer.OVERLAY,
    }
    GtkLayerShell.set_layer(
        win, layers.get(cfg.get("layer", "overlay"), GtkLayerShell.Layer.OVERLAY)
    )
    GtkLayerShell.set_keyboard_mode(win, GtkLayerShell.KeyboardMode.NONE)  # never steal focus
    GtkLayerShell.set_namespace(win, "kde-keybar")

    if cfg.get("monitor") is not None:
        disp = Gdk.Display.get_default()
        monitors = disp.get_monitors() if disp else None
        idx = _int(cfg.get("monitor"), 0)
        if monitors and 0 <= idx < monitors.get_n_items():
            GtkLayerShell.set_monitor(win, monitors.get_item(idx))

    GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.LEFT, True)
    GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.RIGHT, True)
    if cfg.get("position") == "top":
        GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.TOP, True)
    else:
        GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.BOTTOM, True)
        GtkLayerShell.set_margin(win, GtkLayerShell.Edge.BOTTOM, bottom_margin_px(cfg))

    # dock: false = overlay; "bar" = reserve the strip; "keyboard" = reserve the whole
    # band up to the top of the bar (keyboard margin + bar) so windows are pushed above
    # the on-screen keyboard too, not just the strip. true is an alias for "bar".
    dock = cfg.get("dock", False)
    dock = "bar" if dock is True else ("none" if not dock else str(dock))
    if dock != "none":
        bar_h = _int(cfg.get("button_height_px", 54), 54) + 8
        if dock == "keyboard" and cfg.get("position") != "top":
            GtkLayerShell.set_exclusive_zone(win, bottom_margin_px(cfg) + bar_h)
        else:
            GtkLayerShell.set_exclusive_zone(win, bar_h)

    # Buttons fill the width; `overflow` decides what happens when they do not fit:
    #   "scroll" (default) -> single row, extra scrolls sideways
    #   "wrap"             -> flow onto more rows
    # Both keep the bar exactly as tall as the row(s); a bare FlowBox would report a
    # stacked-column natural height and blow the layer surface up to full height.
    bh = _int(cfg.get("button_height_px", 54), 54)
    minw = _int(cfg.get("button_min_width_px", 64), 64)
    sp = 4
    g = _monitor_geometry()
    screen_w = g.width if g is not None else 1280

    layers = {}

    def show(name):
        win.set_child(layers[name])
        return False

    def open_modifier(spec):
        """Swap in a grid of keys that each send modifier+key once, then swap back."""
        mod = str(spec["modifier"]).upper()
        name = f"mod:{mod}"
        if name not in layers:
            label = spec.get("label", mod)
            specs = [{"label": f"{label} ✕", "_back": True, "_latched": True}]
            for k in spec.get("keys") or cfg.get("modifier_keys") or MODIFIER_KEYS:
                ku = str(k).upper()
                specs.append({"label": KEY_LABELS.get(ku, ku), "keys": [mod, ku], "_back": True})
            layers[name] = make_row(specs, wrap=True)
        show(name)

    def make_button(spec):
        b = Gtk.Button(label=spec.get("label", "?"))
        b.set_focusable(False)
        b.set_size_request(minw, bh)
        if spec.get("_latched"):
            b.add_css_class("latched")
        if spec.get("_back"):
            if spec.get("keys"):
                codes = resolve_keys(spec["keys"])
                b.connect("clicked", lambda _b, c=codes: send(c))
            # idle: do not swap the child out from under the button mid-signal
            b.connect("clicked", lambda _b: GLib.idle_add(show, "main"))
            return b
        if spec.get("modifier"):
            b.connect("clicked", lambda _b, sp_=spec: open_modifier(sp_))
            return b
        if spec.get("action") == "dictate" and dictation is not None:
            dictation.attach(b)
            return b
        keys = spec.get("keys", [])
        codes = resolve_keys(keys)
        repeat = spec.get("repeat")
        if repeat is None:
            repeat = len(keys) == 1 and str(keys[0]).upper() in REPEAT_KEYS
        if repeat:
            attach_repeat(b, codes, send, cfg)
        else:
            b.connect("clicked", lambda _b, c=codes: send(c))
        return b

    def make_row(specs, wrap):
        if wrap:
            wrapper = Gtk.FlowBox()
            wrapper.set_selection_mode(Gtk.SelectionMode.NONE)
            wrapper.set_homogeneous(True)
            wrapper.set_max_children_per_line(max(1, len(specs)))
            wrapper.set_min_children_per_line(1)
            wrapper.set_row_spacing(sp)
            wrapper.set_column_spacing(sp)
            wrapper.set_size_request(screen_w - 2 * sp, -1)  # real width -> right row count
            for spec in specs:
                wrapper.append(make_button(spec))
        else:
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=sp)
            box.set_homogeneous(True)
            box.set_size_request(screen_w - 2 * sp, -1)  # fill width; grows -> scrolls
            for spec in specs:
                box.append(make_button(spec))
            wrapper = Gtk.ScrolledWindow()
            # AUTOMATIC keeps touch/wheel scrolling; the scrollbar itself is hidden in CSS.
            # (EXTERNAL hides it too but also stops touch drag-scrolling.)
            wrapper.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.NEVER)
            wrapper.set_propagate_natural_height(True)
            wrapper.set_child(box)
        for m in ("top", "bottom", "start", "end"):
            getattr(wrapper, f"set_margin_{m}")(sp)
        return wrapper

    layers["main"] = make_row(cfg["buttons"], cfg.get("overflow") == "wrap")
    show("main")
    win.kde_keybar_show_layer = show  # lets visibility changes reset to the main layer

    return win


def apply_css(cfg, display, state):
    """(Re)apply the themed stylesheet. Builds the new provider first, so a bad
    value leaves the previous style in place instead of clearing it."""
    st = {**THEMES.get(cfg.get("theme", "dark"), THEMES["dark"]), **cfg.get("style", {})}

    def sv(k, d):
        return st.get(k, d)

    ff = f"font-family: {sv('font_family', '')};" if sv("font_family", "") else ""
    prov = Gtk.CssProvider()
    prov.load_from_string(
        f"""
        window {{ background: {sv("background", "rgba(20,20,24,0.92)")}; }}
        button {{ font-size: {_int(cfg.get("font_px", 20), 20)}px; {ff}
                  padding: {_int(sv("button_padding_px", 6), 6)}px;
                  color: {sv("button_fg", "#eeeeee")};
                  background: {sv("button_bg", "#33343a")};
                  border: {_int(sv("button_border_px", 1), 1)}px solid {sv("button_border", "#4a4b52")};
                  border-radius: {_int(sv("button_radius_px", 8), 8)}px; }}
        button:hover {{ background: {sv("button_hover_bg", "#44454c")}; }}
        button:active {{ background: {sv("button_active_bg", "#5a6cff")}; }}
        button.dictating {{ background: {sv("button_recording_bg", "#c0392b")};
                            color: #ffffff; }}
        scrolledwindow scrollbar {{ opacity: 0; min-height: 0; min-width: 0; }}
        button.latched {{ background: {sv("button_active_bg", "#5a6cff")}; }}
        button.transcribing {{ background: {sv("button_active_bg", "#5a6cff")}; }}
    """
    )
    if state.get("css"):
        Gtk.StyleContext.remove_provider_for_display(display, state["css"])
    Gtk.StyleContext.add_provider_for_display(
        display, prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )
    state["css"] = prov


def setup_visibility(state):
    """Subscribe once to KWin's OSK visibility and show/hide the current window.
    KWin emits its own visibleChanged signal, not Properties.PropertiesChanged."""
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)

    def get_visible():
        try:
            r = bus.call_sync(
                "org.kde.KWin",
                "/VirtualKeyboard",
                "org.freedesktop.DBus.Properties",
                "Get",
                GLib.Variant("(ss)", ("org.kde.kwin.VirtualKeyboard", "visible")),
                GLib.VariantType("(v)"),
                Gio.DBusCallFlags.NONE,
                -1,
                None,
            )
            return r.get_child_value(0).get_variant().get_boolean()
        except GLib.Error:
            return True

    def refresh(*_):
        win = state.get("win")
        if not win:
            return
        visible = bool(state.get("always") or get_visible())
        if not visible and hasattr(win, "kde_keybar_show_layer"):
            win.kde_keybar_show_layer("main")  # a half-finished Ctrl+… does not linger
        win.set_visible(visible)

    for member in ("visibleChanged", "enabledChanged", "activeChanged"):
        bus.signal_subscribe(
            "org.kde.KWin",
            "org.kde.kwin.VirtualKeyboard",
            member,
            "/VirtualKeyboard",
            None,
            Gio.DBusSignalFlags.NONE,
            lambda *a: refresh(),
        )
    state["refresh_visibility"] = refresh


