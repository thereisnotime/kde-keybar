{
  "position": "bottom",
  "visibility": "keyboard",
  "layer": "overlay",
  "dock": false,
  "monitor": null,
  "font_px": 20,
  "button_height_px": 54,
  "button_min_width_px": 64,
  "overflow": "scroll",
  "gap_px": 0,
  "margin_px": null,
  "keyboard_height_fraction": { "landscape": 0.30, "portrait": 0.24 },
  "ydotool_socket": "/run/ydotoold.socket",
  "repeat_delay_ms": 400,
  "repeat_interval_ms": 50,
  "theme": "dark",
  "style": {},
  "buttons": [
    { "label": "Esc",     "keys": ["ESC"] },
    { "label": "Tab",     "keys": ["TAB"] },
    { "label": "Ctrl",    "modifier": "LCTRL" },
    { "label": "Alt+Tab", "keys": ["LALT", "TAB"] },
    { "label": "^C",      "keys": ["LCTRL", "C"] },
    { "label": "^B",      "keys": ["LCTRL", "B"] },
    { "label": "^D",      "keys": ["LCTRL", "D"] },
    { "label": "^L",      "keys": ["LCTRL", "L"] },
    { "label": "^R",      "keys": ["LCTRL", "R"] },
    { "label": "Copy",    "keys": ["LCTRL", "C"] },
    { "label": "Paste",   "keys": ["LCTRL", "V"] },
    { "label": "←",       "keys": ["LEFT"] },
    { "label": "↓",       "keys": ["DOWN"] },
    { "label": "↑",       "keys": ["UP"] },
    { "label": "→",       "keys": ["RIGHT"] },
    { "label": "⏎",       "keys": ["ENTER"] },
    { "label": "🎤",      "action": "dictate" },
    { "label": "⚙",       "action": "settings" }
  ],
  "dictation": {
    "record_command": ["parecord", "--channels=1", "--rate=16000", "--format=s16le", "--file-format=wav", "--latency-msec=50", "{wav}"],
    "transcribe_command": ["whisper-cli", "-m", "{model}", "-f", "{wav}", "-l", "{language}", "-ac", "{audio_ctx}", "-bs", "1", "-bo", "1", "-nt", "-np"],
    "model": "~/.local/share/kde-keybar/models/ggml-base.en.bin",
    "language": "en",
    "output": "type",
    "paste_keys": ["LCTRL", "V"],
    "max_seconds": 120,
    "silence_stop_seconds": 1.5,
    "silence_level": 300
  }
}
